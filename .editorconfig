root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.rs]
indent_size = 4
max_line_length = 100

[*.{ts,js,json,yml,yaml}]
indent_size = 2

[*.md]
# Trailing whitespace is a line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
